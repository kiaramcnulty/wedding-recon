# --- Supabase (from Settings -> API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Places API (server-side only; used for business search in Add Recon) ---
GOOGLE_PLACES_API_KEY=your-places-api-key

# --- App ---
# Used for share deeplinks and auth redirects. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Map tiles ---
# OpenFreeMap needs no key. If you switch to MapTiler, set its style URL/key here.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Analytics (PostHog Cloud, US region; free tier) ---
# The Project API key (starts with phc_). Public by design — used both by the
# browser (instrumentation-client.ts) and server-side (posthog-node) for the two
# conversion events. Leave unset in dev to disable analytics entirely (all
# capture calls no-op; nothing is sent).
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. The browser actually sends to the same-origin /ingest reverse
# proxy (see next.config.ts) to survive host-based ad-blockers; this value is the
# proxy's upstream and the host posthog-node talks to directly.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Vendor Verification billing (Stripe). Optional until the paid tier is live.
# Create one Product with a recurring Price of $120 every 6 months; put its
# price id in STRIPE_PRICE_6MO. The webhook secret is from the Stripe
# dashboard (Developers -> Webhooks) or `stripe listen` for local testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_6MO=
